
weaponDef
{
	// This basically fills out weaponInfo_t
	client {
		standModel			"models/weapons2/venom/venom_stand.mdc"	// weapon pickup 'stand' (do we still use this?)
		pickupModel			"models/weapons2/venom/pu_venom.mdc"
		//pickupSound		"sound/misc/w_pkup.wav"
		bounceSound			"sound/weapons/weaponbounce.wav"
		clipBounceSound		"sound/weapons/clipbounce.wav"

		weaponConfig		"models/weapons2/venom/weapon.cfg"
		handsModel			"models/weapons2/venom/v_venom_hand.md3"

		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/venom/venomf1.wav"		// supports up to 4 flash sounds
		flashEchoSound	    "sound/weapons/venom/venom_far.wav"		// supports up to 4 flash echo sounds
		//lastShotSound		""										// supports up to 4 last shot sounds

		//readySound		""
		//firingSound		""									// no weapons seem to use this, basically it's a replacement hum for readysound, but then when firing
		overheatSound		"sound/weapons/venom/venom_overheat.wav"
		reloadSound			"sound/weapons/venom/venom_reload.wav"
		reloadFastSound		"sound/weapons/venom/venom_reload_fast.wav"		// some weapons have fast reloads due to the skill system
		spinupSound			"sound/weapons/venom/venomsu1.wav"	// sound started when fire button goes down, and stepped on when the first fire event happens
		spindownSound		"sound/weapons/venom/venomsd1.wav"	// sound called if the above is running but player doesn't follow through and fire
		//switchSound		""									// allow overriding of weaponswitch sound
		noAmmoSound         "sound/weapons/misc/fire_dry.wav"

		weaponIcon			"icons/iconw_venom"
		weaponIconScale		2
		weaponSelectedIcon	"icons/iconw_venom_1_select"
		weaponSimpleIcon	"simpleicons/mp34"
		weaponSimpleIconScale 2 1

		weaponCardIcon      "gfx/limbo/weaponcard03"
		weaponCardScale     1 1
		weaponCardPointS    0 1
		weaponCardPointT    0.25 0.375

		//missileModel		""
		//missileSound		""
		//missileTrailFunc	""									// supports "GrenadeTrail", "RocketTrail", "PyroSmokeTrail" and "DynamiteTrail" (we REALLY want a particle system for this)
		//missileDlight		0
		//missileDlightColor	0 0 0							// do we still use this?

		ejectBrassFunc		"MachineGunEjectBrass"				// supports "MachineGunEjectBrass" and "PanzerFaustEjectBrass"

		fireRecoil 0.3 0.6 0    // kick angle
		adjustLean 1 1 1
		reviveLowerHeight 5

		modModel 0		"models/weapons2/venom/venom_barrel.mdc"
		modModel 1		"models/weapons2/venom/venom_barrel.mdc"
		modModel 2		"models/weapons2/venom/venom_barrel.mdc"

		impactDurationCoeff 1
		impactMarkMaxRange  384	// -1 infinite
		impactParticle    "particles/bullet.particle"
		impactSoundVolume 64
		impactMarkRadius  1.5
		// each surface supports up to 5 hits sounds. available surface : default, far, wood, metal, roof, gravel, glass, snow, water, flesh
		impactSound {
			default 5 "sound/weapons/impact/stone"
			wood    5 "sound/weapons/impact/wood"
			metal   5 "sound/weapons/impact/metal"
			roof    5 "sound/weapons/impact/metal"
			glass   5 "sound/weapons/impact/glass"
			water   5 "sound/weapons/impact/water"
			//flesh   5 "sound/weapons/impact/flesh"    // terrible sounds, stonehit is used instead
		}
		// each surface supports up to 1 marks shader. available surface : default, far, wood, metal, roof, gravel, glass, snow, water, flesh
		impactMark {
			default "gfx/damage/bullet_mrk"
			wood    "gfx/damage/wood_mrk"
			metal   "gfx/damage/metal_mrk"
			glass   "gfx/damage/glass_mrk"
		}

		firstPerson {
			model			"models/weapons2/venom/v_venom.md3"
			flashModel		"models/weapons2/venom/v_venom_flash.mdc"

			ejectBrassOffset	15.0 11.0 -8.0

			dynFov90 -3.0 3.2 0.0
			dynFov120 0.5 -0.3 -1.0

			// weapon building
			// the parts are numbered because there are some hardcoded references for some weapons to certain parts
			weaponLink
			{
				part 0
				{
					tag			"tag_barrel"
					model		"models/weapons2/venom/v_venom_barrel.md3"
				}
				part 1
				{
					tag			"tag_barrel2"
					model		"models/weapons2/venom/v_venom_barrel2.mdc"
				}
				part 2
				{
					tag			"tag_barrel3"
					model		"models/weapons2/venom/v_venom_barrel3.md3"
				}		
				part 3
				{
					tag			"tag_barrel4"
					model		"models/weapons2/venom/v_venom_barrel4.mdc"
				}	
				part 4
				{
					tag			"tag_barrel5"
					model		"models/weapons2/venom/v_venom_barrel5.mdc"
				}        
				part 5
				{
					tag			"tag_barrel6"
					model		"models/weapons2/venom/v_venom_barrel6.mdc"
				}  
				part 6
				{
					tag			"tag_needle"
					model		"models/weapons2/venom/venom_needle.md3"
				}
			}
		}

		thirdPerson {
			model			"models/weapons2/venom/venom.mdc"
			flashModel		"models/weapons2/venom/venom_flash.mdc"

			ejectBrassOffset	16 -4 24
		}
	}
}
