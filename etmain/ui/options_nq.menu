#include "ui/menudef.h"
#include "ui/menumacros.h"

// Defines //
#define WINDOW_X                16
#define WINDOW_Y                16
#define WINDOW_WIDTH    160
#define WINDOW_HEIGHT   200
#define GROUP_NAME              "grpOptionsNQ"

// Options Menu //
menuDef {
        name            "options_nq"
        visible         0
        fullscreen      0
        rect            WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
        style           WINDOW_STYLE_FILLED

        onESC {
                close options_nq ;
#ifdef FUI
                open main
#else
                open ingame_main
#endif // FUI
        }

// Window //
        WINDOW( _("^?NO QUARTER^7"), 94 )

// Buttons //
        BUTTON ( 6, 32, WINDOW_WIDTH-12, 18, _("^1CONTROLS"), .3, 14, close options_nq ; open options_nq_controls )
        BUTTON ( 6, 56, WINDOW_WIDTH-12, 18, _("^1DISPLAY"), .3, 14, close options_nq ; open options_nq_display )
        BUTTON ( 6, 80, WINDOW_WIDTH-12, 18, _("^1SOUND"), .3, 14, close options_nq ; open options_nq_sound )
        BUTTON ( 6, 104, WINDOW_WIDTH-12, 18, _("^1HUD"), .3, 14, close options_nq ; open options_nq_hud )
        BUTTON ( 6, 128, WINDOW_WIDTH-12, 18, _("^1TWEAKS"), .3, 14, close options_nq ; open options_nq_tweak )
		BUTTON ( 6, 152, WINDOW_WIDTH-12, 18, _("^1CREDITS"), .3, 14, close options_nq ; open credits_no_quarter )
#ifdef FUI
        BUTTON ( 6, 176, WINDOW_WIDTH-12, 18, _("BACK"), .3, 14, close options_nq ; open main )
#else
        BUTTON ( 6, 176, WINDOW_WIDTH-12, 18, _("BACK"), .3, 14, close options_nq ; open ingame_main )
#endif // FUI

itemDef {
      name      "nq"
      rect      -58 200 232 32
      style      WINDOW_STYLE_SHADER
      background   "ui/assets/logo_nq"
      forecolor   1 1 1 1
      visible      1
      decoration
   }

itemDef {
      name      "versionString"
      group      GROUP_NAME
      rect      6 $evalfloat(216) $evalfloat(WINDOW_WIDTH-200) 12
      text      "^71.3.0"
      textfont   UI_FONT_ARIBLK_16
      textstyle   ITEM_TEXTSTYLE_SHADOWED
      textscale   .25
      textalign   ITEM_ALIGN_LEFT
      textalignx   $evalfloat(.7*(WINDOW_WIDTH-8))
      textaligny   10
      forecolor   1 1 1 1
      visible      1
      decoration
   }
}
